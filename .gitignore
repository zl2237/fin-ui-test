# ================= Python =================
__pycache__/
*.py[cod]
*.cache
.pytest_cache/
venv/
.venv/
# 覆盖率产物（platform/backend/.coveragerc 为配置文件，入库）
htmlcov/
.coverage
.coverage.*

# ================= 前端 / Node =================
platform/frontend/node_modules/
platform/frontend/dist/
platform/frontend/.vite/
# vitest 覆盖率 HTML 报告（npm run test:coverage 产物）
platform/frontend/coverage/
*.tsbuildinfo
# OpenAPI 类型生成中间产物（api.gen.ts 由 gen:api 重新生成并提交）
platform/frontend/openapi.json

# ================= 敏感配置（含数据库密码，勿提交）=================
# .env 与 .env.local 任意层级生效；.env.example 示例文件正常入库
.env
.env.local

# ================= 运行产物 =================
logs/
*.log
# 文件中心物理存储（内容寻址落盘，路径可被 UPLOAD_ROOT 覆盖）
platform/backend/uploads/
# 库数据备份（scripts 备份/数据修复库行备份，含数据勿提交；任意层级同名目录）
backups/

# ================= 会话临时 / 防再生（2026-11-05 大清扫后）=================
Temp/
.ruff_cache/
.tmp_*
# codegen 录制产物（含业务系统凭据，永不入库；2026-11-05 移出跟踪）
/record.py
record.py_*_report.txt

# ================= 下划线调试文件约定 =================
# 任意目录下划线开头 = 调试文件不入库；两类例外必须入库：
# Python 包标记（app/crud 等新包）与前端测试目录（vitest 约定）
**/_*
!**/__init__.py
!**/__tests__/
!**/__tests__/**

# ================= IDE / 系统文件 =================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
